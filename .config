CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_phicomm_k2p-a2=y

# 基础系统
CONFIG_BUSYBOX_DEFAULT_FEATURES=y
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_KERNEL_BUILD_HOST=""
CONFIG_KERNEL_BUILD_TIMESTAMP=""
CONFIG_KERNEL_CC="-g0"

# 文件系统
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=16

# 网络基础（Passwall必备，不要删除）
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca988x-ct=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y

# LuCI基础界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Passwall 整套开启
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_passwall-core=y
CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y

# 精简项：关闭无用组件
# CONFIG_PACKAGE_opkg=y
# CONFIG_PACKAGE_ipv6-support=y
CONFIG_LUCI_LANG_en=n
CONFIG_PACKAGE_luci-app-firewall=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_hostapd=n
