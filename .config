CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_phicomm_k2p-a2=y

# 基础系统
CONFIG_LINUX_5_15=y
CONFIG_BUSYBOX_DEFAULT_SED=y
CONFIG_BUSYBOX_DEFAULT_FEATURE_TOP_SMP_CPU=n
CONFIG_BUSYBOX_DEFAULT_FEATURE_TOP_DECIMALS=n

# 网络基础
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_switch=y

# Luci 中文后台
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# 必备证书（拉订阅、离线插件依赖）
CONFIG_PACKAGE_ca-bundle=y

# 关闭IPv6
CONFIG_IPV6=n
CONFIG_PACKAGE_kmod-ip6tables=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n

# 精简无用组件
CONFIG_PACKAGE_opkg=n
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_nano=n
CONFIG_PACKAGE_bash=n
CONFIG_PACKAGE_wget=n
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_upnp=n
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y

# 不预内置passwall（你后期离线安装）
CONFIG_PACKAGE_luci-app-passwall=n
