CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_phicomm_k2p=y

# 精简基础系统
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG_INFO=n
CONFIG_BUSYBOX_CONFIG_CROND=n
CONFIG_BUSYBOX_CONFIG_CRONTAB=n

# 关闭IPv6（瘦身需要，不需要可以开启）
CONFIG_IPV6=n

# 无线驱动 K2P必备
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_ath10k-firmware-qca988x=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# 基础网络
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_opkg=y

# 删除多余工具
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_iperf3=n
CONFIG_PACKAGE_vnstat=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_luci-app-statistics=n

# LuCI最简网页后台
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 关闭各类日志（缩小固件体积）
CONFIG_LOG=n
CONFIG_LOGD=n
